    classDef shared fill:#fff9db,stroke:#c9ba78,color:#1e293b;
    classDef foundation fill:#e7f5ff,stroke:#91b8d2,color:#1e293b;
    class Entry,Input entry;
    class Business,Draft,Plan business;
    class Shared,Execute,Result shared;
