{
  "name": "@qwenpaw-data/context-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "audit:all": "npm audit --audit-level=high",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sbom": "node scripts/generate-sbom.mjs",
    "test": "node --experimental-strip-types --experimental-loader ./src/utils/semanticConfigContract.loader.mjs --test 'src/**/*.test.ts'",
    "test:semantic-config": "node --experimental-strip-types --experimental-loader ./src/utils/semanticConfigContract.loader.mjs ./src/utils/semanticConfigContract.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@agentscope-ai/design": "^1.0.14",
    "@ant-design/icons": "npm:@agentscope-ai/icons-override-antd@6.0.0",
    "@ant-design/pro-components": "^2.8.10",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@antv/g6": "^5.1.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@liquidglass/react": "0.1.3",
    "@rc-component/util": "1.2.1",
    "@uiw/codemirror-theme-github": "^4.25.8",
    "@uiw/react-codemirror": "^4.25.8",
    "antd": "^5.29.1",
    "axios": "^1.10.0",
    "classnames": "^2.5.1",
    "docx-preview": "^0.4.0",
    "i18next": "^25.8.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.6.2",
    "xlsx": "npm:@e965/xlsx@0.20.3",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "@ant-design/icons": "npm:@agentscope-ai/icons-override-antd@6.0.0",
    "https-proxy-agent": "7.0.6",
    "lodash": "4.18.1",
    "semver": "7.8.5",
    "path-to-regexp": "^8.3.1",
    "dompurify": "^3.4.17",
    "postcss": "^8.5.23",
    "decode-uri-component": "^0.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "less": "^4.6.7",
    "prettier": "^3.9.9",
    "terser": "^5.46.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.3.4"
  }
}
