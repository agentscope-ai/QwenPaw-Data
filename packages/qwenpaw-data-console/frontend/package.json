    "@agentscope-ai/chat": "1.2.0-beta.1789645658876",
    "@agentscope-ai/design": "^1.0.14",
    "@agentscope-ai/icons": "1.0.68",
    "@ant-design/icons": "npm:@agentscope-ai/icons-override-antd@6.0.0",
    "@ant-design/plots": "^2.6.5",
    "@liquidglass/react": "0.1.3",
    "antd": "^5.29.1",
    "dayjs": "^1.11.21",
    "decode-named-character-reference": "1.3.0",
    "katex": "0.16.47",
    "lucide-react": "^0.561.0",
    "parse5": "7.3.0",
    "rc-virtual-list": "^3.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.6.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
