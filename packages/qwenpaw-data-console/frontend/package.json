{
  "name": "@qwenpaw-data/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix ../../qwenpaw-data-context/frontend run build:embedded && vite",
    "build": "npm --prefix ../../qwenpaw-data-context/frontend run build:embedded && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "patch-package",
    "test": "tsc -p tsconfig.test.json && (cd node_modules/.tmp/dataconsole-tests/features/console/model/__test__ && node --test) && (cd node_modules/.tmp/dataconsole-tests/features/console/model/tests && node --test) && (cd node_modules/.tmp/dataconsole-tests/services/__test__ && node --test)",
    "preview": "vite preview"
  },
