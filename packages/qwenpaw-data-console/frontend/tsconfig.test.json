    "src/features/console/model/cronSchedule.ts",
    "src/features/console/model/__test__/*.test.ts",
    "src/features/console/types.ts",
    "src/services/auth.ts",
    "src/services/config.ts",
    "src/services/__test__/*.test.ts"
  ]
