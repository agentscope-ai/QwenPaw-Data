{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "moduleDetection": "auto",
    "noEmit": false,
    "outDir": "./node_modules/.tmp/dataconsole-tests",
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/types/*.d.ts",
    "src/features/console/model/__test__/*.test.ts",
    "src/features/console/model/tests/*.test.ts",
    "src/services/__test__/*.test.ts"
  ]
}
