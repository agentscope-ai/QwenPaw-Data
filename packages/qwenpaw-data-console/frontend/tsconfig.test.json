{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "moduleDetection": "auto",
    "noEmit": false,
    "outDir": "./node_modules/.tmp/dataconsole-tests",
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/features/console/api/sseFrames.ts",
    "src/features/console/api/types.ts",
